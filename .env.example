# Copiar a .env y completar. Nunca commitear .env con credenciales reales.

# Conexión a PostgreSQL (Supabase en producción; Postgres local en desarrollo).
DATABASE_URL=postgresql://usuario:password@localhost:5432/invictos_dev

# Supabase Auth (T3). Se obtienen del panel del proyecto de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio, para construir el enlace de vuelta del login sin
# contraseña (src/app/auth/callback). En producción, la URL real del sitio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secreto compartido de las tareas programadas (T26/T28): lo manda
# pg_cron + pg_net (Supabase) en el header "Authorization: Bearer <secreto>"
# al pegarle a /api/tareas/*. Generar uno propio por entorno (cadena larga
# al azar), nunca reusar este valor, y cargarlo en Vercel → Settings →
# Environment Variables (pasos-infraestructura-T28.md, paso 5).
CRON_SECRET=

# Sentry (T28, observabilidad). DSN del proyecto Next.js creado en sentry.io.
# Sin esto, el SDK queda inactivo en desarrollo — no hace falta para levantar
# el proyecto localmente.
SENTRY_DSN=

# Google Places Autocomplete para la dirección al crear un torneo — que la
# sede sea un lugar que Maps reconozca de verdad, no texto libre. Se genera
# en https://console.cloud.google.com: crear/elegir un proyecto → habilitar
# "Places API" y "Maps JavaScript API" → Credenciales → crear una API key →
# restringirla a esas dos APIs y, en producción, también por referrer HTTP
# al dominio del sitio. Pide facturación habilitada en la cuenta de Google
# Cloud (tiene cuota gratis mensual, pero exige una tarjeta cargada). Sin
# esto, el campo de dirección sigue funcionando como texto libre — nunca
# bloquea crear el torneo (D-52).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
