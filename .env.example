# Copiar a .env y completar. Nunca commitear .env con credenciales reales.

# Conexión a PostgreSQL (Supabase en producción; Postgres local en desarrollo).
#
# EN PRODUCCIÓN: usar la cadena del pooler en MODO TRANSACCIÓN, puerto 6543
# (panel de Supabase → Connect → "Transaction pooler"), nunca la de modo
# sesión (5432). En modo sesión cada conexión se queda con un lugar del
# pooler mientras viva, el cupo del plan gratuito es 15 para todo el
# proyecto, y en Vercel cada instancia abre su propio pool: con varias
# personas a la vez la aplicación devuelve EMAXCONNSESSION en vez de la
# página. Ver pasos-infraestructura-T28.md, paso 5.
DATABASE_URL=postgresql://usuario:password@localhost:5432/invictos_dev

# Solo para las migraciones del despliegue. Va la conexión DIRECTA
# (Supabase → Connect → "Direct connection"), no el pooler en modo
# transacción: node-pg-migrate usa un advisory lock de sesión, y por el
# pooler se tomaría en una conexión y se liberaría en otra — puede quedar
# colgado y trabar los despliegues siguientes. En desarrollo no hace
# falta: si no está, se usa DATABASE_URL.
DATABASE_URL_MIGRACIONES=

# Supabase Auth (T3). Se obtienen del panel del proyecto de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio, para construir el enlace de vuelta del login sin
# contraseña (src/app/auth/callback). En producción, la URL real del sitio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secreto compartido de las tareas programadas (T26/T28): lo manda
# pg_cron + pg_net (Supabase) en el header "Authorization: Bearer <secreto>"
# al pegarle a /api/tareas/*. Generar uno propio por entorno (cadena larga
# al azar), nunca reusar este valor, y cargarlo en Vercel → Settings →
# Environment Variables (pasos-infraestructura-T28.md, paso 5).
CRON_SECRET=

# Sentry (T28, observabilidad). DSN del proyecto Next.js creado en sentry.io.
# Sin esto, el SDK queda inactivo en desarrollo — no hace falta para levantar
# el proyecto localmente.
SENTRY_DSN=
