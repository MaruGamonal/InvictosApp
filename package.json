{
  "name": "invictos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "migrate:create": "node-pg-migrate create --migrations-dir db/migrations --",
    "migrate:up": "dotenv -e .env -q -- node-pg-migrate up --migrations-dir db/migrations",
    "migrate:down": "dotenv -e .env -q -- node-pg-migrate down --migrations-dir db/migrations",
    "verify": "npm run format && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "next": "15.5.25",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.25",
    "eslint-plugin-boundaries": "7.2.0",
    "node-pg-migrate": "8.0.4",
    "pg": "8.23.0",
    "@types/pg": "8.23.1",
    "dotenv-cli": "11.0.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "postcss": "8.5.26"
  }
}
